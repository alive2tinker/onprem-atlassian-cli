{
  "mcpServers": {
    "onprem-atlassian": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-e",
        "JIRA_URL",
        "-e",
        "JIRA_PERSONAL_TOKEN",
        "-e",
        "JIRA_SSL_VERIFY=true",
        "-e",
        "CONFLUENCE_URL",
        "-e",
        "CONFLUENCE_PERSONAL_TOKEN",
        "-e",
        "CONFLUENCE_SSL_VERIFY=true",
        "ghcr.io/sooperset/mcp-atlassian:latest"
      ]
    }
  }
}
