{
  "name": "@local/onprem-atlassian-cli",
  "version": "0.1.0",
  "description": "Cross-platform local-AI CLI for on-prem Jira and Confluence via mcp-atlassian.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "onprem-atlassian": "./bin/onprem-atlassian.js",
    "atlas-ai": "./bin/onprem-atlassian.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/",
    "src/",
    "skills/",
    "scripts/",
    "skills.manifest.json",
    ".mcp.json",
    "README.md"
  ],
  "scripts": {
    "doctor": "node ./bin/onprem-atlassian.js doctor",
    "skills": "node ./bin/onprem-atlassian.js skills list",
    "verify:skills": "node ./scripts/verify-skills.mjs",
    "sync:skills": "node ./scripts/sync-skills.mjs"
  }
}
