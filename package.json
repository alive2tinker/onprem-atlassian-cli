{
  "name": "atli",
  "version": "0.2.0",
  "description": "Short namespace-first local-AI CLI for on-prem Jira and Confluence via mcp-atlassian.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "atli": "./bin/atli.js",
    "atlas-ai": "./bin/atli.js",
    "onprem-atlassian": "./bin/atli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/",
    "src/",
    "skills/",
    "scripts/",
    "skills.manifest.json",
    ".mcp.json",
    "README.md"
  ],
  "scripts": {
    "doctor": "node ./bin/atli.js doctor",
    "skills": "node ./bin/atli.js skills list",
    "verify:skills": "node ./scripts/verify-skills.mjs",
    "sync:skills": "node ./scripts/sync-skills.mjs"
  }
}
